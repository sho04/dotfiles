# shellcheck shell=sh

if [ -r "$HOME/.config/dotfiles/shell/env.bash" ]; then
    # env.bash uses Bash arrays to deduplicate PATH, so only source it here
    # when this login shell is Bash.
    if [ -n "${BASH_VERSION:-}" ]; then
        . "$HOME/.config/dotfiles/shell/env.bash"
    fi
fi

if [ -n "${BASH_VERSION:-}" ] && [ -r "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
fi
